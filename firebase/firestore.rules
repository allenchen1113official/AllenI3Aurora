rules_version = '2';

// =====================================================================
// 艾倫報報 · Allen I³ Aurora — Firestore 安全規則
// ---------------------------------------------------------------------
// 任何人可「讀」各區塊資料（前台顯示用）；
// 僅指定 email 登入後可「寫」（新增 / 修改 / 刪除）。
// 部署：Firebase Console → Firestore Database → 規則(Rules) 貼上並發布，
//       或 CLI： firebase deploy --only firestore:rules
// 若要更換管理者 email，改下方 OWNER_EMAIL。
// 未列出的其他 collection 一律拒絕（預設安全）。
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'allenchen1113.official@gmail.com'; // OWNER_EMAIL
    }

    // 各區塊 collection：公開讀、管理者寫
    match /aurora_stats/{doc}    { allow read: if true; allow write: if isOwner(); }
    match /aurora_focus/{doc}    { allow read: if true; allow write: if isOwner(); }
    match /aurora_reading/{doc}  { allow read: if true; allow write: if isOwner(); }
    match /aurora_podcasts/{doc} { allow read: if true; allow write: if isOwner(); }
    match /aurora_links/{doc}    { allow read: if true; allow write: if isOwner(); }
    match /aurora_issues/{doc}   { allow read: if true; allow write: if isOwner(); }
    match /aurora_annuli/{doc}   { allow read: if true; allow write: if isOwner(); }

    // 電子報訂閱者：任何人可「建立」訂閱（嚴格欄位驗證），
    // 讀取／修改／刪除僅限管理者 —— email 名單不可被外部讀走。
    // doc id 即 email 小寫，同一 email 重複訂閱會因 update 被拒而擋下。
    match /aurora_subscribers/{email} {
      function subValid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'cadence', 'status', 'consent', 'source', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['email', 'cadence', 'status', 'consent', 'source', 'createdAt', 'updatedAt'])
          && d.email is string && d.email == email && d.email.lower() == d.email
          && d.email.size() >= 6 && d.email.size() <= 254
          && d.email.matches('[^@\\s]+@[^@\\s]+\\.[^@\\s]+')
          && d.cadence is map
          && d.cadence.keys().hasOnly(['day', 'week', 'month'])
          && d.cadence.keys().hasAll(['day', 'week', 'month'])
          && d.cadence.day is bool && d.cadence.week is bool && d.cadence.month is bool
          && (d.cadence.day || d.cadence.week || d.cadence.month)
          && d.status == 'active'
          && d.consent == true
          && d.source == 'web'
          && d.createdAt is string && d.createdAt.size() <= 40
          && d.updatedAt is string && d.updatedAt.size() <= 40;
      }
      allow create: if isOwner() || subValid();
      allow read, update, delete: if isOwner();
    }
  }
}
